{
  "name": "flowforge-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "node --experimental-sqlite src/server.js",
    "worker": "node --experimental-sqlite src/worker.js",
    "start": "node --experimental-sqlite src/server.js",
    "test": "node --experimental-sqlite --test tests/*.test.js",
    "check": "node --check src/server.js && node --check src/worker.js && node --check public/app.js"
  }
}
